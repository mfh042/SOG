# 应用
APP_NAME=SOG 离散装配生产作业支援系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# PostgreSQL 18（异步驱动 psycopg3）
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sog
DB_USER=sog
DB_PASSWORD=sog_pass
# 连接池：高并发调大 pool_size / max_overflow
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

# 并发与任务
WORKER_THREADS=16          # 阻塞/CPU 任务线程池大小
ASYNC_CONCURRENCY=32       # 异步协程并发信号量上限

# 可选：Redis（缓存 / 后续消息队列预留，留空则不启用）
REDIS_URL=

# 跨域
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
