APP_NAME=DELV-SOG 离散装配生产作业支援系统
APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=sog
DB_USER=postgres
DB_PASSWORD=123456
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=30
DB_POOL_RECYCLE=1800
DB_ECHO=false

WORKER_THREADS=16
ASYNC_CONCURRENCY=32

REDIS_URL=

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ============================================================
# 外部系统集成配置
# integration_mode=LOCAL  独立运行，不依赖任何外部系统（默认）
# integration_mode=INTEGRATED  启用外部系统对接，按需开启 ERP/MES/PLM/WMS
# ============================================================
INTEGRATION_MODE=LOCAL

ERP_ENABLED=false
ERP_BASE_URL=
ERP_API_KEY=
ERP_SYNC_INTERVAL=60

MES_ENABLED=false
MES_BASE_URL=
MES_API_KEY=
MES_SYNC_INTERVAL=60

PLM_ENABLED=false
PLM_BASE_URL=
PLM_API_KEY=
PLM_SYNC_INTERVAL=60

WMS_ENABLED=false
WMS_BASE_URL=
WMS_API_KEY=
WMS_SYNC_INTERVAL=60

# ------------------------------------------------------------
# SAP S/4HANA OData 适配器
#  base_url 示例: https://s4hanahost:443
#  认证二选一:
#   SAP_USERNAME / SAP_PASSWORD  (Basic Auth)
#   SAP_API_KEY                   (OAuth2 Bearer Token)
# ------------------------------------------------------------
SAP_ENABLED=false
SAP_BASE_URL=
SAP_USERNAME=
SAP_PASSWORD=
SAP_API_KEY=
SAP_SYNC_INTERVAL=60

# ------------------------------------------------------------
# 金蝶云星空 / 金蝶云苍穹
#  base_url 示例: https://kdcloud.cosmichc.com
#  认证方式二选一:
#   1) KINGDEE_USERNAME + KINGDEE_PASSWORD + KINGDEE_ACCT_ID  (ValidateUser 换取 session)
#   2) KINGDEE_API_KEY  (access_token 直接认证)
#  可选: KINGDEE_X_ACGW_IDENTITY  (金蝶云苍穹 API 网关身份头)
# ------------------------------------------------------------
KINGDEE_ENABLED=false
KINGDEE_BASE_URL=
KINGDEE_API_KEY=
KINGDEE_USERNAME=
KINGDEE_PASSWORD=
KINGDEE_ACCT_ID=
KINGDEE_X_ACGW_IDENTITY=
KINGDEE_SYNC_INTERVAL=60

# ------------------------------------------------------------
# 用友 NC Cloud / YonBIP OpenAPI
#  base_url 示例: https://nccloud.yonyou.com
#  认证二选一:
#   1) YONYOU_APP_KEY + YONYOU_APP_SECRET + YONYOU_TENANT_ID  (AK/SK 签名)
#   2) YONYOU_API_KEY  (Bearer Token)
# ------------------------------------------------------------
YONYOU_ENABLED=false
YONYOU_BASE_URL=
YONYOU_APP_KEY=
YONYOU_APP_SECRET=
YONYOU_TENANT_ID=
YONYOU_API_KEY=
YONYOU_SYNC_INTERVAL=60